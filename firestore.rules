rules_version = '2';

// กฎความปลอดภัยของ Firestore สำหรับ FC ALL-STAR
//
// หลักการ: ผู้เล่นอ่าน/เขียนได้เฉพาะเซฟของตัวเอง · แอดมินอ่านได้ทุกคน ·
// ตั้งค่าเกมทุกคนอ่านได้แต่มีแต่แอดมินที่เขียนได้
//
// วิธีตั้งแอดมิน: สร้าง document ที่ admins/{uid ของคนนั้น} ด้วยมือใน Console
// (ตั้งใจให้สร้างจาก Console เท่านั้น — ไม่มีกฎไหนให้ client สร้างเองได้)
//
// ชื่อคอลเลกชันทุกอันตรงกับ PATHS ใน src/features/cloud/firebase.ts
// ถ้าแก้ที่นั่นต้องแก้ที่นี่ด้วย ไม่งั้นฟีเจอร์นั้นจะเงียบไปเฉย ๆ

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // ---- เซฟของผู้เล่น ----
    // เจ้าของอ่าน/เขียนได้ · แอดมินอ่านได้ (แผงแอดมินต้องมองเห็นรายชื่อไอดี)
    // และเขียนได้ (เสกเงิน/เสกการ์ด)
    match /accounts/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ---- รายชื่อแอดมิน ----
    // เจ้าตัวอ่าน document ของตัวเองได้อย่างเดียว — เกมต้องอ่านได้ ไม่งั้นถามไม่ได้ว่า
    // ตัวเองเป็นแอดมินหรือเปล่า แล้วปุ่มแอดมินจะไม่มีวันขึ้น
    // (checkAdmin ใน CloudAuthProvider เรียก getDoc ตรง ๆ กฎอ่านตัวนี้จึงจำเป็น
    //  คนละเรื่องกับ exists() ที่ isAdmin() ใช้ ซึ่งทำงานในกฎด้วยกันเองไม่ต้องพึ่งสิทธิ์อ่าน)
    // อ่านของคนอื่นไม่ได้ (จะได้ไม่รู้ว่าใครเป็นแอดมินบ้าง) และเขียนไม่ได้เลย
    // ต้องสร้างจาก Console เท่านั้น
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // ---- ตารางจองชื่อ ----
    // ทุกคนอ่านได้ เพราะตอน sign in ต้องแปลงชื่อ -> uid ก่อนถึงจะรู้ว่า login ด้วยอะไร
    // จองได้ครั้งเดียว: create ผ่านเฉพาะตอนที่ยังไม่มีใครจอง และต้องจองเป็นของตัวเอง
    // แก้/ลบไม่ได้เลย ชื่อจึงถูกแย่งหรือขโมยไม่ได้
    match /usernames/{name} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ---- ตั้งค่าเกม (คลังการ์ด แพ็ค ดราฟต์ ถ้วย แบนเนอร์ walkout) ----
    // ทุกคนอ่านได้ รวมคนที่ยังไม่ล็อกอิน เพราะหน้าแรกต้องโหลดก่อนสมัคร
    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---- ตารางอันดับ OVR + แรงก์เมเนเจอร์โหมด ----
    // สองอย่างนี้อยู่ใน document เดียวกัน (เขียนแบบ merge) ทุกคนที่ล็อกอินอ่านได้
    // เพราะต้องเห็นทีมของคนอื่น — และคู่แข่งในถ้วยก็ดึงจากคอลเลกชันนี้
    // เขียนได้เฉพาะแถวของตัวเอง แก้แถวคนอื่นไม่ได้แม้ยิง request เองจาก DevTools
    //
    // หมายเหตุ: กฎชุดนี้เคยหายไปจากไฟล์ ทั้งที่โค้ดเรียกใช้อยู่ — ผลคือตารางอันดับ
    // กับคู่แข่งจริงในถ้วยจะเงียบไปทั้งระบบโดยไม่มี error ให้เห็น
    match /leaderboard/{uid} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // ---- ฟีดผู้โชคดีจากกาชาปอง ----
    // เขียนได้อย่างเดียว ต่อท้ายเท่านั้น แก้หรือลบไม่ได้เลย
    // แถวในฟีดเป็นแค่ "คำกล่าวอ้างว่าหมุนได้อะไร" ไม่ได้ให้ของอะไรกับใคร
    // แถวปลอมจึงเสียแค่พื้นที่หนึ่งบรรทัด และต้องเป็นชื่อตัวเองเท่านั้น
    match /gachaFeed/{row} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      // ลบได้ (ไว้ล้างประกาศ) แต่แก้ข้อความย้อนหลังไม่ได้
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- รายงานเซฟล้มเหลว ----
    // เบราว์เซอร์ของผู้เล่นเขียนรายงานของตัวเองตอนเซฟบัญชีขึ้นคลาวด์ไม่ผ่าน
    // เขียนได้เฉพาะแถวของตัวเอง (uid ใน path ต้องตรงกับคนที่ล็อกอิน)
    // อ่านและลบได้เฉพาะแอดมิน — ผู้เล่นไม่ต้องเห็นรายงานของคนอื่น
    // แยกเป็นเอกสารเล็กของตัวเองโดยตั้งใจ: ตอนที่เอกสารบัญชีโดนปฏิเสธ
    // การเขียนเอกสารอื่นที่มีแค่ไม่กี่ช่องยังผ่านได้ รายงานถึงจะไปถึงแอดมิน
    match /saveErrors/{uid} {
      allow read, delete: if isAdmin();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.uid == uid;
    }

    // ---- ไลฟ์แชทหน้าแรก ----
    // ต่อท้ายได้อย่างเดียว แก้ไม่ได้ · แอดมินลบได้ (ไว้ลบข้อความไม่เหมาะสม)
    // ต้องเป็น uid ตัวเอง · ข้อความ 1–120 ตัวอักษร · เวลาต้องเป็นเวลาเซิร์ฟเวอร์
    // เลเวลกับ OVR ในแถวเป็นแค่ "ค่าที่ผู้ส่งบอกเอง" ไว้แสดงผลเท่านั้น ไม่ได้ตรวจกับเซฟ
    // ความยาว 120 ต้องตรงกับ CHAT_MAX_LENGTH ใน src/features/cloud/cloudChat.ts
    match /chat/{row} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['uid', 'username', 'avatarId', 'level', 'ovr', 'text', 'at'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.username is string
        && request.resource.data.username.size() <= 40
        && request.resource.data.avatarId is string
        && request.resource.data.level is int
        && request.resource.data.ovr is int
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 120
        && request.resource.data.at == request.time;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- 1 OF 1: การ์ดใบแรกของเซิร์ฟที่ตีติด +9 / +10 ----
    // หนึ่งเอกสารต่อหนึ่งตำแหน่งแชมป์ (การ์ด + ระดับ) · สร้างได้ครั้งเดียว แก้ไม่ได้
    // คนแรกที่สร้างได้คือเจ้าของ — ใครมาทีหลังเขียนทับไม่ได้ · แอดมินลบได้ (ไว้รีเซ็ต)
    // ต้องเป็น uid ตัวเอง และระดับต้องเป็น 9 หรือ 10
    // ตรงกับ src/features/cloud/cloudOneOfOne.ts
    match /oneOfOne/{key} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.key == key
        && request.resource.data.level in [9, 10];
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ---- อย่างอื่นปิดหมด ----
    // ปฏิเสธไว้ก่อนเสมอ: คอลเลกชันใหม่ที่เพิ่มทีหลังจะไม่เปิดให้เขียนโดยบังเอิญ
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
